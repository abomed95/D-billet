# D-Billet - Cloud Run configuration reference
#
# Cloud Run does not read a .env file: values are passed to the service as
# environment variables (--set-env-vars) or as Secret Manager references
# (--set-secrets). deploy/gcp/deploy-cloudrun.sh does both; this file
# documents what ends up where.
#
# Anything under "SECRETS" must NEVER be passed with --set-env-vars: plain
# env vars are visible to anyone with read access to the service.

# ============ PLAIN ENVIRONMENT VARIABLES ============

APP_ENV=production

# Public URLs. Use the custom domain once it is mapped, otherwise the
# https://<service>-<hash>-<region>.a.run.app URL Cloud Run assigns.
APP_URL=https://d-billet.com
FRONTEND_URL=https://d-billet.com
BACKEND_CORS_ORIGINS=https://d-billet.com,https://www.d-billet.com

DB_NAME=dbillet
# Managed clusters are slower to elect a primary than a local mongod.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Cloud Storage volume mount. The container filesystem is ephemeral: every
# path outside this mount is lost when the instance is recycled.
UPLOAD_DIR=/mnt/uploads

# uvicorn worker processes per instance. Keep 1 and scale with instances:
# the in-app rate limiter (services/rate_limit.py) counts per process, so
# more workers means proportionally looser limits.
WEB_CONCURRENCY=1

# Google OAuth client id is public (it ships in the frontend bundle).
GOOGLE_CLIENT_ID=

# WaafiPay non-secret settings
WAAFIPAY_BASE_URL=https://api.waafipay.net/asm
WAAFIPAY_CURRENCY=DJF
WAAFIPAY_HPP_PAYMENT_METHOD=MWALLET_ACCOUNT

# Production safety. Both are forced off when APP_ENV=production, they are
# repeated here only to make the intent explicit.
AUTO_SEED_DEMO_DATA=false
ALLOW_PUBLIC_SEED_ROUTE=false

# ============ SECRETS (Secret Manager) ============
# Created by deploy-cloudrun.sh and mounted with --set-secrets.
#
#   dbillet-jwt-secret          -> JWT_SECRET
#   dbillet-mongo-url           -> MONGO_URL
#   dbillet-google-client-secret-> GOOGLE_CLIENT_SECRET   (optional)
#   dbillet-waafipay-api-key    -> WAAFIPAY_API_KEY       (optional)
#   dbillet-waafipay-hpp-key    -> WAAFIPAY_HPP_KEY       (optional)
#   dbillet-waafipay-merchant   -> WAAFIPAY_MERCHANT_UID  (optional)
#   dbillet-waafipay-store      -> WAAFIPAY_STORE_ID      (optional)
#   dbillet-waafipay-api-user   -> WAAFIPAY_API_USER_ID   (optional)
#
# Add a secret version later:
#   printf '%s' 'VALUE' | gcloud secrets versions add dbillet-mongo-url --data-file=-
#   gcloud run services update dbillet --region <region> \
#     --update-secrets WAAFIPAY_API_KEY=dbillet-waafipay-api-key:latest

# ============ BUILD-TIME (frontend, baked into the bundle) ============
# Passed as --build-arg, not as runtime env vars. Changing them requires a
# rebuild, not just a redeploy.
#
#   REACT_APP_BACKEND_URL=https://d-billet.com
#   REACT_APP_SITE_URL=https://d-billet.com

# D-Billet backend production environment
# Copy to backend/.env on the server and replace placeholder values.

APP_ENV=production

# Public URLs
APP_URL=https://d-billet.com
FRONTEND_URL=https://d-billet.com
BACKEND_CORS_ORIGINS=https://d-billet.com,https://www.d-billet.com

# DigitalOcean Managed MongoDB
# Paste the full connection string shown in the DigitalOcean control panel.
MONGO_URL=mongodb://doadmin:CHANGE_ME@db-mongodb-nyc3-12345-0.db.ondigitalocean.com:25060/admin?tls=true&authSource=admin&replicaSet=db-mongodb-nyc3-12345
DB_NAME=dbillet
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Security
# MANDATORY in production. Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Google OAuth (leave blank to keep the button disabled in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- WaafiPay payment gateway ----
# Two flows are supported:
#   * DIRECT WALLET DEBIT (recommended): the customer enters their Waafi number
#     on D-Billet and approves on their phone. Enabled by the API credentials
#     (MERCHANT_UID + API_USER_ID + API_KEY). Takes priority when set.
#   * HOSTED PAYMENT PAGE (redirect): enabled by MERCHANT_UID + STORE_ID + HPP_KEY.
# Leave everything blank to keep payments in simulation mode.
# Production endpoint (default): https://api.waafipay.net/asm
# Sandbox endpoint:              https://sandbox.waafipay.com/asm
WAAFIPAY_BASE_URL=https://api.waafipay.net/asm
WAAFIPAY_MERCHANT_UID=
# Direct wallet debit (API_PURCHASE) credentials:
WAAFIPAY_API_USER_ID=
WAAFIPAY_API_KEY=
# Hosted Payment Page (redirect) credentials:
WAAFIPAY_STORE_ID=
WAAFIPAY_HPP_KEY=
# Currency sent to WaafiPay (ISO 4217). Djibouti Franc by default.
WAAFIPAY_CURRENCY=DJF
# WaafiPay HPP payment method (mandatory on the gateway side).
# MWALLET_ACCOUNT = mobile wallet (Waafi). Leave as default unless WaafiPay
# tells you to use another value for your merchant group.
WAAFIPAY_HPP_PAYMENT_METHOD=MWALLET_ACCOUNT

# Persistent uploads on the Droplet
UPLOAD_DIR=/var/www/dbillet/shared/uploads

# Production safety - DO NOT enable on a public server
AUTO_SEED_DEMO_DATA=false
ALLOW_PUBLIC_SEED_ROUTE=false

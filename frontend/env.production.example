# D-Billet frontend production environment
# Copy to frontend/.env.production on the server before the build.

# Important: use the public site origin, without /api.
REACT_APP_BACKEND_URL=https://d-billet.com
REACT_APP_SITE_URL=https://d-billet.com

# Keep local tooling disabled in production builds.
ENABLE_HEALTH_CHECK=false
ENABLE_VISUAL_EDITS=false
VISUAL_EDIT_ALLOWED_ORIGINS=

# Disable source maps in production
GENERATE_SOURCEMAP=false
